---
import Icon from "./Icon.astro";
import { ruta } from "../lib/rutas";
import { ICONS } from "../data/icons";

/**
 * Un solo componente para Certificados y Participaciones: en el diseño son
 * la misma card y solo cambian las líneas de `meta`.
 */
interface Props {
  titulo: string;
  descripcion: string;
  imagen: string;
  meta: string[];
  pdf: string;
}

const { titulo, descripcion, imagen, meta, pdf } = Astro.props;
---

<article
  class="glass group flex flex-col rounded-[var(--radius-card)] shadow-glow-soft transition-[transform,box-shadow,border-color] duration-200 ease-out hover:-translate-y-[4px] hover:border-ink/30 hover:shadow-glow"
>
  <div class="h-[192px] shrink-0 overflow-hidden rounded-t-[var(--radius-card)] border-b border-divider">
    <img
      src={ruta(imagen)}
      alt={`Vista previa de ${titulo}`}
      width="387"
      height="192"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]"
    />
  </div>

  <div class="flex flex-1 flex-col gap-[10px] px-[10px] py-[20px]">
    <h3 class="px-[5px] text-[24px] leading-[28px] font-bold text-blue">
      {titulo}
    </h3>

    <p class="p-[5px] text-[16px] leading-[19px] text-ink">{descripcion}</p>

    <div class="mt-auto flex items-center justify-between gap-[5px] p-[10px]">
      <p class="px-[5px] text-[16px] leading-[21px] text-green">
        {meta.map((linea) => <span class="block">{linea}</span>)}
      </p>

      <a
        href={ruta(pdf)}
        target="_blank"
        rel="noopener noreferrer"
        class="group/link inline-flex items-center gap-[8px] rounded-[8px] p-[5px] text-[16px] leading-[21px] text-green transition-[filter] duration-200 ease-out hover:brightness-125 hover:drop-shadow-[0_0_8px_rgb(158_206_106/0.5)]"
      >
        <span
          class="underline decoration-transparent decoration-1 underline-offset-4 transition-colors duration-200 group-hover/link:decoration-current"
          >Ver PDF</span
        >
        <span class="sr-only">de {titulo}</span>
        <Icon path={ICONS.pdf} size={22} />
      </a>
    </div>
  </div>
</article>
