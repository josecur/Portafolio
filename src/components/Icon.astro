---
interface Props {
  path: string;
  size?: number;
  class?: string;
}

const { path, size = 24, class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path d={path} />
</svg>
