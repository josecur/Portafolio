---
interface Props {
  id: string;
  titulo: string;
  /** El diseño usa 30px en WhoIAm y 37px en el resto */
  gap?: number;
}

const { id, titulo, gap = 30 } = Astro.props;
---

<section
  id={id}
  class="flex w-full max-w-[var(--spacing-main)] scroll-mt-[calc(var(--spacing-header)+36px)] flex-col items-start px-[clamp(16px,3.2vw,40px)] py-[16px]"
  style={`gap:${gap}px`}
  aria-labelledby={`${id}-titulo`}
>
  <div class="flex w-full max-w-[var(--spacing-content)] items-center p-[10px]">
    <h2 id={`${id}-titulo`} class="text-titulo leading-[40px] text-cyan">
      {titulo}
    </h2>
  </div>
  <slot />
</section>
