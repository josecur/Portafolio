---
import { PERFIL } from "../data/icons";

/**
 * Headbar flotante. No va de borde a borde a propósito: centrada y con aire
 * arriba y a los lados, el fondo se ve alrededor y la barra se lee como un
 * panel sobre la escena, no como una franja que la tapa.
 *
 * El nav del mockup era un prototipo (listaba "Experiencia", que no existe
 * como artboard). Aquí refleja las secciones reales.
 */
const NAV = [
  { id: "whoiam", label: "WhoIAm" },
  { id: "stack", label: "Stack Tecnologico" },
  { id: "proyectos", label: "Proyectos" },
  { id: "certificados", label: "Certificados" },
  { id: "participaciones", label: "Participaciones" },
];
---

<header
  class="glass sticky top-[16px] z-50 mx-auto flex h-[var(--spacing-header)] w-[calc(100%-32px)] max-w-[var(--spacing-main)] items-center justify-between rounded-[var(--radius-btn)] px-[clamp(16px,3.2vw,48px)] shadow-glow max-[820px]:flex-col max-[820px]:items-stretch max-[820px]:justify-center max-[820px]:gap-[6px] max-[820px]:px-[16px] max-[820px]:py-[10px]"
>
  <a
    href="#whoiam"
    class="text-[clamp(15px,1.4vw,17px)] leading-[22px] font-bold text-ink transition-[color,text-shadow] duration-200 ease-out hover:text-amber hover:[text-shadow:0_0_10px_rgb(255_202_115_/_0.5)]"
  >
    {PERFIL.nombre}
  </a>

  <nav
    class="tira max-[820px]:-mx-[16px] max-[820px]:w-[calc(100%+32px)] max-[820px]:overflow-x-auto max-[820px]:px-[16px]"
    aria-label="Secciones del portafolio"
  >
    <ul class="flex list-none items-center gap-[clamp(12px,1.6vw,22px)] max-[820px]:w-max max-[820px]:gap-[20px]">
      {
        NAV.map(({ id, label }) => (
          <li>
            <a
              href={`#${id}`}
              data-nav={id}
              class="block py-[8px] max-[820px]:py-[12px] text-[clamp(13px,1.1vw,14px)] leading-[18px] whitespace-nowrap text-ink transition-[color,transform,text-shadow] duration-200 ease-out hover:-translate-y-[2px] hover:text-amber aria-[current=true]:text-amber aria-[current=true]:[text-shadow:0_0_10px_rgb(255_202_115_/_0.5)]"
            >
              - {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /*
   * La tira de secciones se arrastra con el dedo. Se le quita la barra porque
   * en una fila de 37px ocupa casi tanto como el propio texto; el corte del
   * ultimo enlace ya indica que hay mas a la derecha.
   */
  .tira {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .tira::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Scroll-spy: marca el enlace de la sección visible.
  const enlaces = new Map<string, HTMLAnchorElement>(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")].map((a) => [
      a.dataset.nav!,
      a,
    ]),
  );

  const secciones = [...enlaces.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let activo: string | null = null;

  const marcar = (id: string) => {
    if (id === activo) return;
    if (activo) enlaces.get(activo)?.removeAttribute("aria-current");
    enlaces.get(id)?.setAttribute("aria-current", "true");
    activo = id;
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((e) => e.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible) marcar(visible.target.id);
    },
    { rootMargin: "-20% 0px -70% 0px", threshold: 0 },
  );

  secciones.forEach((s) => observer.observe(s));
  if (secciones[0]) marcar(secciones[0].id);
</script>
