---
import {
  astronauta,
  ovni,
  VARIANTES,
  ASTRO_W,
  ASTRO_H,
  OVNI_W,
  OVNI_H,
} from "../lib/sprites";

/**
 * Eventos aleatorios del fondo.
 *
 * Registro, no casos sueltos: cada evento declara su probabilidad, duración y
 * trayectoria, y el planificador tira un dado por cada uno cada 10s. Añadir el
 * siguiente (satélite, cometa) es un <figure> aquí y una línea en EVENTOS.
 *
 * Viven dentro de .fondo pero FUERA de .escena: no los arrastra el parallax
 * del scroll, así que cruzan la ventana estés donde estés en la página.
 *
 * Los sprites se generan en build con la misma técnica de grabado que los
 * planetas (ver src/lib/sprites.ts).
 */
---

<div class="eventos" aria-hidden="true">
  {/* Tres poses del astronauta; el planificador elige una al azar */}
  {
    VARIANTES.map((v) => (
      <figure class="evento astronauta" data-evento="astronauta" data-pose={v}>
        <svg viewBox={`0 0 ${ASTRO_W} ${ASTRO_H}`} set:html={astronauta(v)} />
      </figure>
    ))
  }

  <figure class="evento ovni" data-evento="ovni">
    <svg viewBox={`0 0 ${OVNI_W} ${OVNI_H}`} set:html={ovni()} />
  </figure>
</div>

<style>
  .eventos {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .evento {
    position: absolute;
    top: var(--y, 40vh);
    left: 0;
    margin: 0;
    opacity: 0;
    will-change: transform, opacity;
  }

  /* El viewBox va 1:1 con estos píxeles: nada de detalle sub-píxel */
  .astronauta {
    width: 110px;
  }
  .ovni {
    width: 118px;
  }

  .evento svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .evento.corriendo {
    animation: cruzar var(--dur) linear forwards;
  }

  /*
   * scaleX(var(--flip)) espeja el sprite según el sentido de la marcha, para
   * que el cordón del astronauta quede siempre por detrás.
   */
  @keyframes cruzar {
    0% {
      transform: translate(var(--x0), 0) scaleX(var(--flip)) rotate(0deg);
      opacity: 0;
    }
    7% {
      opacity: var(--op);
    }
    93% {
      opacity: var(--op);
    }
    100% {
      transform: translate(var(--x1), var(--dy)) scaleX(var(--flip))
        rotate(var(--giro));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eventos {
      display: none;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>(".eventos");

  if (raiz && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const TICK = 10_000; // cada cuánto se tira el dado
    const PRIMER_TIRO = 15_000; // margen para que la página asiente

    interface Evento {
      id: string;
      /** Probabilidad POR TIRO */
      prob: number;
      /** Segundos que tarda en cruzar */
      dur: number;
      /** Vuelta que da sobre sí mismo durante el trayecto */
      giro: number;
      /** Banda vertical donde puede aparecer, en vh */
      banda: [number, number];
      /** Deriva vertical durante el cruce, en vh */
      deriva: number;
      opacidad: number;
    }

    /*
     * ORDEN IMPORTANTE: el corto va primero. Con "uno a la vez", el evento
     * que se comprueba antes acapara los turnos; como el astronauta ocupa 32s
     * y el ovni 3, ponerlo delante le devuelve al ovni un 12% de apariciones
     * y al astronauta sólo le cuesta un 2%.
     */
    const EVENTOS: Evento[] = [
      {
        // El raro: el huevo de pascua
        id: "ovni",
        prob: 0.025,
        dur: 3,
        giro: 0,
        banda: [8, 45],
        deriva: 4,
        opacidad: 0.62,
      },
      {
        // 10% y 32s deja al astronauta en pantalla ~26% del tiempo, con una
        // aparición cada ~2 min. Al 15% subía al 43% y dejaba de ser evento.
        id: "astronauta",
        prob: 0.1,
        dur: 32,
        giro: 210,
        banda: [12, 66],
        deriva: 9,
        opacidad: 0.55,
      },
    ];

    // Un evento puede tener varias poses; se elige una al azar en cada salida
    const nodos = new Map<string, HTMLElement[]>(
      EVENTOS.map((e) => [
        e.id,
        [...raiz.querySelectorAll<HTMLElement>(`[data-evento="${e.id}"]`)],
      ]),
    );

    // Uno a la vez: si coinciden dos, deja de ser especial
    let enCurso = false;

    const lanzar = (e: Evento) => {
      const opciones = nodos.get(e.id);
      if (!opciones || !opciones.length) return;
      const el = opciones[Math.floor(Math.random() * opciones.length)];
      enCurso = true;

      const haciaLaDerecha = Math.random() < 0.5;
      const [min, max] = e.banda;

      el.style.setProperty("--y", `${min + Math.random() * (max - min)}vh`);
      el.style.setProperty("--x0", haciaLaDerecha ? "-25vw" : "125vw");
      el.style.setProperty("--x1", haciaLaDerecha ? "125vw" : "-25vw");
      el.style.setProperty("--flip", haciaLaDerecha ? "1" : "-1");
      el.style.setProperty("--dy", `${(Math.random() * 2 - 1) * e.deriva}vh`);
      el.style.setProperty("--dur", `${e.dur}s`);
      el.style.setProperty("--giro", `${e.giro * (haciaLaDerecha ? 1 : -1)}deg`);
      el.style.setProperty("--op", `${e.opacidad}`);

      el.classList.add("corriendo");
      el.addEventListener(
        "animationend",
        () => {
          el.classList.remove("corriendo");
          enCurso = false;
        },
        { once: true },
      );
    };

    const tirar = () => {
      // No acumular tiradas con la pestaña en segundo plano
      if (enCurso || document.visibilityState !== "visible") return;
      for (const e of EVENTOS) {
        if (Math.random() < e.prob) {
          lanzar(e);
          return; // uno por tirada
        }
      }
    };

    setTimeout(() => {
      tirar();
      setInterval(tirar, TICK);
    }, PRIMER_TIRO);

    /*
     * Disparador manual para no tener que esperar al dado mientras se ajusta
     * el dibujo. Solo en dev: en el build de producción no se emite.
     */
    if (import.meta.env.DEV) {
      (window as any).evento = (id: string, pose?: string) => {
        const e = EVENTOS.find((x) => x.id === id);
        if (!e) return `no existe: ${EVENTOS.map((x) => x.id).join(", ")}`;
        enCurso = false;
        if (pose) {
          const el = raiz.querySelector<HTMLElement>(`[data-pose="${pose}"]`);
          if (!el) return `no existe esa pose`;
          nodos.set(e.id, [el]);
          lanzar(e);
          nodos.set(e.id, [
            ...raiz.querySelectorAll<HTMLElement>(`[data-evento="${e.id}"]`),
          ]);
        } else {
          lanzar(e);
        }
        return `lanzado: ${id}${pose ? " / " + pose : ""} (${e.dur}s)`;
      };
      console.info(
        '[fondo] evento("astronauta") | evento("astronauta","espaldas") | evento("ovni")',
      );
    }
  }
</script>
