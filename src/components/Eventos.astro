---
/**
 * Eventos aleatorios del fondo.
 *
 * Registro, no casos sueltos: cada evento declara su probabilidad, duración
 * y trayectoria, y el planificador tira un dado por cada uno cada 10s.
 * Añadir el siguiente (satélite, cometa, estación) es meter un <figure> aquí
 * y una línea en EVENTOS del script.
 *
 * Viven dentro de .fondo pero FUERA de .escena: no los arrastra el parallax
 * del scroll, así que cruzan la ventana estés donde estés en la página.
 */
---

<div class="eventos" aria-hidden="true">
  <!-- Astronauta a la deriva: cruza lento y girando sobre sí mismo -->
  <figure class="evento astronauta" data-evento="astronauta">
    <svg viewBox="0 0 120 150" fill="none" stroke="#C0CAF5" stroke-width="2.2"
      stroke-linecap="round" stroke-linejoin="round">
      <!-- Cordón umbilical, ondeando hacia atrás -->
      <path d="M41 84C29 94 21 76 9 90C5 94 3 97 0 99" stroke-width="1.6" opacity="0.75" />

      <!-- Mochila, detrás del torso -->
      <rect x="37" y="61" width="46" height="38" rx="7" opacity="0.85" />
      <path d="M45 68v24M75 68v24" stroke-width="1.4" opacity="0.5" />

      <!-- Piernas -->
      <path d="M51 99c-6 9-8 16-7 24M69 99c6 9 8 16 7 24" />
      <path d="M42 126c3 5 8 6 12 3M69 129c3 4 9 4 12-1" stroke-width="3" />

      <!-- Brazos -->
      <path d="M43 69c-8 3-15 8-19 15s-6 10-9 12" />
      <path d="M78 69c9 1 16 0 22-4s7-6 9-8" />
      <circle cx="13" cy="98" r="4.5" stroke-width="1.8" />
      <circle cx="110" cy="55" r="4.5" stroke-width="1.8" />

      <!-- Torso -->
      <path d="M43 62h34l-3 38H46z" />
      <!-- Grabado del torso: sombra por la derecha -->
      <path d="M64 68v26M70 70v22" stroke-width="1.3" opacity="0.55" />

      <!-- Casco -->
      <circle cx="60" cy="36" r="25" />
      <!-- Visor -->
      <ellipse cx="60" cy="34" rx="17" ry="14" stroke-width="1.8" opacity="0.9" />
      <!-- Grabado del casco: luz arriba-izquierda, sombra abajo-derecha -->
      <path d="M78 51a25 25 0 0 1-11 9M82 44a25 25 0 0 1-6 11" stroke-width="1.4" opacity="0.6" />
      <!-- Reflejo en el visor -->
      <path d="M50 27a10 8 0 0 1 8-4" stroke-width="1.5" opacity="0.7" />
      <!-- Cuello -->
      <path d="M50 58h20" stroke-width="2" />
    </svg>
  </figure>

  <!-- OVNI: atraviesa la pantalla disparado, dudas de haberlo visto -->
  <figure class="evento ovni" data-evento="ovni">
    <svg viewBox="0 0 180 80" fill="none" stroke="#C0CAF5" stroke-width="2.2"
      stroke-linecap="round" stroke-linejoin="round">
      <!-- Cúpula -->
      <path d="M53 42Q90 2 127 42" />
      <path d="M67 38q4-22 12-27M90 33V13M103 38q-4-22-12-27" stroke-width="1.3" opacity="0.6" />

      <!-- Platillo -->
      <ellipse cx="90" cy="43" rx="78" ry="13" />
      <!-- Reborde inferior -->
      <path d="M40 47a52 52 0 0 0 100 0" stroke-width="1.7" opacity="0.85" />
      <!-- Grabado del casco: rayas radiales -->
      <path d="M28 40l10 4M52 36l6 6M128 42l6-6M142 44l10-4" stroke-width="1.3" opacity="0.55" />

      <!-- Luces -->
      <g fill="#C0CAF5" stroke="none" opacity="0.9">
        <circle cx="58" cy="52" r="3.4" /><circle cx="74" cy="56" r="3.4" />
        <circle cx="90" cy="57" r="3.4" /><circle cx="106" cy="56" r="3.4" />
        <circle cx="122" cy="52" r="3.4" />
      </g>
    </svg>
  </figure>
</div>

<style>
  .eventos {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .evento {
    position: absolute;
    top: var(--y, 40vh);
    left: 0;
    margin: 0;
    opacity: 0;
    will-change: transform, opacity;
  }

  .astronauta {
    width: 72px;
  }
  .ovni {
    width: 118px;
  }

  .evento svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .evento.corriendo {
    animation: cruzar var(--dur) linear forwards;
  }

  /*
   * scaleX(var(--flip)) espeja el sprite según el sentido de la marcha, para
   * que el cordón del astronauta quede siempre por detrás.
   */
  @keyframes cruzar {
    0% {
      transform: translate(var(--x0), 0) scaleX(var(--flip)) rotate(0deg);
      opacity: 0;
    }
    7% {
      opacity: var(--op);
    }
    93% {
      opacity: var(--op);
    }
    100% {
      transform: translate(var(--x1), var(--dy)) scaleX(var(--flip))
        rotate(var(--giro));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eventos {
      display: none;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>(".eventos");

  if (raiz && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const TICK = 10_000; // cada cuánto se tira el dado
    const PRIMER_TIRO = 15_000; // margen para que la página asiente

    interface Evento {
      id: string;
      /** Probabilidad POR TIRO. 0.05 con TICK=10s ≈ uno cada 3.3 min */
      prob: number;
      /** Segundos que tarda en cruzar */
      dur: number;
      /** Vuelta que da sobre sí mismo durante el trayecto */
      giro: number;
      /** Banda vertical donde puede aparecer, en vh */
      banda: [number, number];
      /** Deriva vertical durante el cruce, en vh */
      deriva: number;
      opacidad: number;
    }

    const EVENTOS: Evento[] = [
      {
        id: "astronauta",
        prob: 0.05,
        dur: 40,
        giro: 210,
        banda: [12, 66],
        deriva: 9,
        opacidad: 0.55,
      },
      {
        // El más raro de los dos: es el huevo de pascua
        id: "ovni",
        prob: 0.025,
        dur: 3,
        giro: 0,
        banda: [8, 45],
        deriva: 4,
        opacidad: 0.62,
      },
    ];

    const nodos = new Map(
      EVENTOS.map((e) => [
        e.id,
        raiz.querySelector<HTMLElement>(`[data-evento="${e.id}"]`)!,
      ]),
    );

    // Uno a la vez: si coinciden dos, deja de ser especial
    let enCurso = false;

    const lanzar = (e: Evento) => {
      const el = nodos.get(e.id);
      if (!el) return;
      enCurso = true;

      const haciaLaDerecha = Math.random() < 0.5;
      const [min, max] = e.banda;

      el.style.setProperty("--y", `${min + Math.random() * (max - min)}vh`);
      el.style.setProperty("--x0", haciaLaDerecha ? "-25vw" : "125vw");
      el.style.setProperty("--x1", haciaLaDerecha ? "125vw" : "-25vw");
      el.style.setProperty("--flip", haciaLaDerecha ? "1" : "-1");
      el.style.setProperty("--dy", `${(Math.random() * 2 - 1) * e.deriva}vh`);
      el.style.setProperty("--dur", `${e.dur}s`);
      el.style.setProperty("--giro", `${e.giro * (haciaLaDerecha ? 1 : -1)}deg`);
      el.style.setProperty("--op", `${e.opacidad}`);

      el.classList.add("corriendo");
      el.addEventListener(
        "animationend",
        () => {
          el.classList.remove("corriendo");
          enCurso = false;
        },
        { once: true },
      );
    };

    const tirar = () => {
      // No acumular tiradas con la pestaña en segundo plano
      if (enCurso || document.visibilityState !== "visible") return;
      for (const e of EVENTOS) {
        if (Math.random() < e.prob) {
          lanzar(e);
          return; // uno por tirada
        }
      }
    };

    setTimeout(() => {
      tirar();
      setInterval(tirar, TICK);
    }, PRIMER_TIRO);

    /*
     * Disparador manual para no tener que esperar al dado mientras se ajusta
     * el dibujo. Solo en dev: en el build de producción no se emite.
     */
    if (import.meta.env.DEV) {
      (window as any).evento = (id: string) => {
        const e = EVENTOS.find((x) => x.id === id);
        if (!e) return `no existe: ${EVENTOS.map((x) => x.id).join(", ")}`;
        enCurso = false;
        lanzar(e);
        return `lanzado: ${id} (${e.dur}s)`;
      };
      console.info('[fondo] evento("astronauta") | evento("ovni")');
    }
  }
</script>
