---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Fondo from "../components/Fondo.astro";
import { PERFIL } from "../data/icons";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${PERFIL.nombre} — ${PERFIL.rol}`,
  description = PERFIL.titulo,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="theme-color" content="#15161f" />
    <meta name="author" content={PERFIL.nombre} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={PERFIL.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <Fondo />

    <Header />

    <main class="mx-auto w-[var(--spacing-main)] pt-[10px]">
      <slot />
      <Footer />
    </main>

  </body>
</html>
